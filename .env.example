# Copie vers .env.local puis renseigne les valeurs

# --- Base de donnees ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ARCC_DB?schema=public"

# --- Auth (NextAuth/Auth.js) ---
AUTH_SECRET="CHANGE_ME_32+CHARS_MINIMUM"
ARCC_ADMIN_EMAILS="admin@kladriva.ca"

# --- Google (optionnel) ---
GOOGLE_CLIENT_ID="OPTIONAL"
GOOGLE_CLIENT_SECRET="OPTIONAL"

# --- Stripe (paiement en ligne) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID Stripe pour l'adhesion (mode payment)
STRIPE_MEMBERSHIP_PRICE_ID="price_..."

# --- URL site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

