    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.400.0",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.30",
    "next-mdx-remote": "^4.4.1",
    "openai": "^5.23.1",
    "postcss": "^8",
    "prisma": "^6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^20.4.1",
