{
  "name": "kladriva-corporate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "deploy:build": "npm run build",
    "deploy:prepare": "npm run build && echo '✅ Build ready for deployment' && echo '📁 Upload the contents of the out/ folder to your hosting'",
    "deploy:test": "npm run build && cd out && python -m http.server 8000"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "^18",
    "react-dom": "^18",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next-mdx-remote": "^4.4.1",
    "gray-matter": "^4.0.3",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.4.6"
  }
}
